{
  "name": "bellwether-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.11"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:verifiers": "tsx packages/cli/src/bin.ts verify-verifiers --suite core",
    "bench:sim": "tsx packages/cli/src/bin.ts run --suite core --driver sim --agent scripted --k 5 --seed 20260902 --out .bellwether/sim",
    "bench:curve": "tsx packages/cli/src/bin.ts run --suite core --driver sim --agent flaky --k 5 --seed 20260902 --out .bellwether/curve",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "release": "changeset publish",
    "bench:compiled": "tsx packages/cli/src/bin.ts run --suite core --driver sim --agent compiled --k 5 --seed 20260902 --out .bellwether/compiled",
    "flows": "tsx scripts/compile-flows.ts",
    "docs:pdf": "node scripts/build-pdf.mjs"
  },
  "devDependencies": {
    "@bellwether/compile": "workspace:*",
    "@bellwether/core": "workspace:*",
    "@bellwether/solari": "workspace:*",
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@solarisdk/sandbox": "0.1.2",
    "@types/node": "^22.18.9",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  }
}
