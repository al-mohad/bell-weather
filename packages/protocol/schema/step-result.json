{
  "$id": "https://bellwether.dev/schema/1.0/step-result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "click"
            },
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "button": {
              "default": "left",
              "type": "string",
              "enum": [
                "left",
                "right",
                "middle"
              ]
            },
            "clicks": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "rationale": {
              "type": "string",
              "maxLength": 2000
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "x",
            "y"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "move"
            },
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rationale": {
              "type": "string",
              "maxLength": 2000
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "x",
            "y"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "type"
            },
            "text": {
              "type": "string",
              "maxLength": 4096
            },
            "rationale": {
              "type": "string",
              "maxLength": 2000
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "key"
            },
            "keys": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "rationale": {
              "type": "string",
              "maxLength": 2000
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "keys"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "scroll"
            },
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "direction": {
              "type": "string",
              "enum": [
                "up",
                "down",
                "left",
                "right"
              ]
            },
            "amount": {
              "default": 3,
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "rationale": {
              "type": "string",
              "maxLength": 2000
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "x",
            "y",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "navigate"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "rationale": {
              "type": "string",
              "maxLength": 2000
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "wait"
            },
            "ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30000
            },
            "rationale": {
              "type": "string",
              "maxLength": 2000
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "ms"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "done"
            },
            "summary": {
              "type": "string",
              "maxLength": 2000
            },
            "rationale": {
              "type": "string",
              "maxLength": 2000
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "abstain"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "rationale": {
              "type": "string",
              "maxLength": 2000
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "reason"
          ]
        }
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "action"
  ]
}
