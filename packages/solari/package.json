{
  "name": "@bellwether/solari",
  "version": "0.1.0",
  "description": "Driver abstraction over Solari browsers, sandboxes and desktops, plus a deterministic simulator and a record/replay transport.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@bellwether/core": "workspace:*",
    "@bellwether/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@solarisdk/browser": "*",
    "@solarisdk/desktop": "*",
    "@solarisdk/sandbox": "*"
  },
  "peerDependenciesMeta": {
    "@solarisdk/browser": {
      "optional": true
    },
    "@solarisdk/desktop": {
      "optional": true
    },
    "@solarisdk/sandbox": {
      "optional": true
    }
  }
}
